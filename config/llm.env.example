# LLM 配置模板
# =============
# 用法：把本文件复制成 config/llm.env，填入你的密钥即可。
#       src/llm.py 会自动读取它，你不用每开一个终端就设一次环境变量。
#       环境变量优先级高于本文件（已存在的同名环境变量不会被覆盖）。
#
# 自检：python src/llm.py

# ---------------------------------------------------------------- DeepSeek
# 官方 OpenAI 兼容端点。base_url 与 model 由预设自动填好，无需手写。
OPENAI_PROVIDER=deepseek
OPENAI_API_KEY=sk-在这里填你的密钥

# 模型名请以官方定价文档为准 —— 厂商换名很频繁。
# DeepSeek 已于 2026-07-24 下线旧的 deepseek-chat / deepseek-reasoner 别名，
# 现在的官方模型是 deepseek-flash 与 deepseek-v4-pro。
# 想指定别的模型就取消下面这行的注释（不写则用预设的 deepseek-flash）：
# OPENAI_MODEL=deepseek-flash

# 超时秒数，默认 60
# OPENAI_TIMEOUT_SECONDS=60


# ---------------------------------------------------------------- 其他服务商
# 换服务商只需改 OPENAI_PROVIDER（已内置预设）：
#   openai / deepseek / dashscope / moonshot / zhipu / siliconflow
#
# 用预设里没有的服务商，就直接写 base_url + model：
# OPENAI_PROVIDER=custom
# OPENAI_BASE_URL=https://your-endpoint.example.com/v1
# OPENAI_MODEL=your-model-name
# OPENAI_API_KEY=sk-xxx
